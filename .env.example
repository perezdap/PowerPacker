# PowerPacker Environment Variables Configuration

# The LLM Provider to use ('OpenAI' or 'Anthropic')
POWERPACKER_LLM_PROVIDER=OpenAI

# The API Key for the chosen provider
POWERPACKER_LLM_API_KEY=your_api_key_here

# (Optional) The Base URL for the LLM API. Useful for proxy servers or alternative providers compatible with OpenAI/Anthropic.
POWERPACKER_LLM_BASE_URL=

# (Optional) The LLM Model to use. Defaults to 'gpt-4' for OpenAI and 'claude-3-opus-20240229' for Anthropic.
POWERPACKER_LLM_MODEL=
